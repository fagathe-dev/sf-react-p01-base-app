{#
  Création d'un compte administrateur (commande core-php:create-admin-user).

  ⚠️ Contient le mot de passe en clair : l'utilisateur doit le changer puis supprimer définitivement cet e-mail.

  Variables : dto (App\Dto\Mail\AdminAccountCreatedMailDto), app_name (contexte commun core-php)
#}
{% extends '@CorePhp/layout.html.twig' %}

{% set app = app_name|default('l\'application') %}

{% block content %}
  {% include '@CorePhp/components/_alert.html.twig' with {
    type: 'danger',
    title: '⚠️ E-mail confidentiel : action requise',
    content: 'Cet e-mail contient votre <strong>mot de passe en clair</strong>. Pour votre sécurité :<br><br>
      <strong>1.</strong> Changez votre mot de passe avec le lien ci-dessous avant de vous connecter<br>
      <strong>2.</strong> <strong>Supprimez définitivement cet e-mail</strong> (pas seulement dans la corbeille)'
  } only %}

  {% include '@CorePhp/components/_divider.html.twig' only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h1',
    content: 'Bienvenue dans l\'équipe ' ~ (app|e) ~ ' !'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Bonjour <strong>' ~ (dto.recipientName|e) ~ '</strong>,'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Un compte administrateur a été créé pour vous sur <strong>' ~ (app|e) ~ '</strong>'
      ~ (dto.createdBy == 'command' ? ' depuis la ligne de commande' : ' depuis le tableau de bord')
      ~ '. Voici le récapitulatif de vos informations de connexion.'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h3',
    content: '🔐 Vos informations de connexion'
  } only %}

  {% set row_label = 'padding: 10px 0; color: #6c757d; width: 160px; vertical-align: top;' %}
  {% set row_value = 'padding: 10px 0; color: #212529;' %}

  {% include '@CorePhp/components/_card.html.twig' with {
    padding: '20px',
    custom_style: 'border: 1px solid #e2e8f0; border-radius: 8px;',
    content: '<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="font-size: 14px;">'
      ~ '<tr><td style="' ~ row_label ~ '"><strong>Nom d\'utilisateur</strong></td>'
      ~ '<td style="' ~ row_value ~ ' font-family: monospace; font-size: 15px;">' ~ (dto.username|e) ~ '</td></tr>'
      ~ '<tr><td style="' ~ row_label ~ '"><strong>Adresse e-mail</strong></td>'
      ~ '<td style="' ~ row_value ~ '">' ~ (dto.recipientEmail|e) ~ '</td></tr>'
      ~ '<tr><td style="' ~ row_label ~ '"><strong>Mot de passe</strong></td>'
      ~ '<td style="' ~ row_value ~ ' color: #dc3545; font-family: monospace; font-size: 15px; font-weight: bold; background: #fff3cd; padding-left: 10px; border-radius: 4px;">' ~ (dto.plainPassword|e) ~ '</td></tr>'
      ~ '<tr><td style="' ~ row_label ~ '"><strong>Rôle</strong></td>'
      ~ '<td style="' ~ row_value ~ ' color: #0d6efd; font-weight: 600;">' ~ (dto.roleLabel|e) ~ '</td></tr>'
      ~ '<tr><td style="' ~ row_label ~ '"><strong>Date de création</strong></td>'
      ~ '<td style="' ~ row_value ~ '">' ~ (dto.createdAt|date('d/m/Y à H:i')) ~ '</td></tr>'
      ~ '</table>'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h3',
    content: '🚀 Prochaine étape : choisir votre mot de passe'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Avant votre première connexion, remplacez ce mot de passe provisoire par un mot de passe personnel :'
  } only %}

  {% include '@CorePhp/components/_section.html.twig' with {
    align: 'center',
    padding: '16px 0',
    content: include('@CorePhp/components/_button.html.twig', {
      url: dto.changePasswordUrl,
      label: 'Changer mon mot de passe',
      bg_color: '#198754',
      text_color: '#ffffff'
    }, with_context = false)
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'small',
    color: '#64748b',
    content: 'Ce lien est valable <strong>' ~ (dto.ttlHours|e) ~ ' heures</strong> et ne peut être utilisé qu\'une seule fois. Passé ce délai, utilisez « Mot de passe oublié ? » sur la page de connexion.'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Une fois votre mot de passe modifié, connectez-vous :'
  } only %}

  {% include '@CorePhp/components/_section.html.twig' with {
    align: 'center',
    padding: '16px 0',
    content: include('@CorePhp/components/_button.html.twig', {
      url: dto.loginUrl,
      label: 'Se connecter',
      bg_color: '#0f172b',
      text_color: '#ffffff'
    }, with_context = false)
  } only %}

  {% include '@CorePhp/components/_divider.html.twig' only %}

  {% include '@CorePhp/components/_alert.html.twig' with {
    type: 'warning',
    title: '🛡️ Rappel de sécurité',
    content: '<ul style="margin: 10px 0; padding-left: 20px;">'
      ~ '<li style="margin-bottom: 8px;">Ne partagez <strong>jamais</strong> vos identifiants</li>'
      ~ '<li style="margin-bottom: 8px;">Choisissez un mot de passe fort (8 caractères minimum, majuscule, minuscule et chiffre)</li>'
      ~ '<li style="margin-bottom: 8px;"><strong>Supprimez définitivement cet e-mail</strong> après avoir changé votre mot de passe</li>'
      ~ '</ul>'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'small',
    color: '#64748b',
    content: 'Si vous n\'êtes pas à l\'origine de cette demande ou pensez avoir reçu cet e-mail par erreur, contactez immédiatement l\'équipe technique.'
  } only %}
{% endblock %}
