{#
  Création d'un compte administrateur (commande core-php:create-admin-user).

  ⚠️ Contient le mot de passe en clair : l'utilisateur doit le changer puis supprimer définitivement cet e-mail.

  Variables : dto (App\Dto\Mail\AdminAccountCreatedMailDto), app_name (contexte commun core-php)
#}
{% extends '@CorePhp/layout.html.twig' %}

{% set app = app_name|default('l\'application') %}

{% block content %}
  {% include '@CorePhp/components/_alert.html.twig' with {
    type: 'danger',
    title: '⚠️ E-mail confidentiel : action requise',
    content: 'Cet e-mail contient votre <strong>mot de passe en clair</strong>. Pour votre sécurité :<br><br>
      <strong>1.</strong> Changez votre mot de passe avec le lien ci-dessous avant de vous connecter<br>
      <strong>2.</strong> <strong>Supprimez définitivement cet e-mail</strong> (pas seulement dans la corbeille)'
  } only %}

  {% include '@CorePhp/components/_divider.html.twig' only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h1',
    content: 'Bienvenue dans l\'équipe ' ~ (app|e) ~ ' !'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Bonjour <strong>' ~ (dto.recipientName|e) ~ '</strong>,'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Un compte administrateur a été créé pour vous sur <strong>' ~ (app|e) ~ '</strong>'
      ~ (dto.createdBy == 'command' ? ' depuis la ligne de commande' : ' depuis le tableau de bord')
      ~ '. Voici le récapitulatif de vos informations de connexion.'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h3',
    content: '🔐 Vos informations de connexion'
  } only %}

  {% include '@CorePhp/components/_details.html.twig' with {
    rows: [
      { label: 'Nom d\'utilisateur', value: dto.username, mono: true },
      { label: 'Adresse e-mail', value: dto.recipientEmail },
      { label: 'Mot de passe', value: dto.plainPassword, mono: true, tone: 'danger' },
      { label: 'Rôle', value: dto.roleLabel, tone: 'primary' },
      { label: 'Date de création', value: dto.createdAt|date('d/m/Y à H:i') }
    ]
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h3',
    content: '🚀 Prochaine étape : choisir votre mot de passe'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Avant votre première connexion, remplacez ce mot de passe provisoire par un mot de passe personnel :'
  } only %}

  {% include '@CorePhp/components/_button.html.twig' with {
    url: dto.changePasswordUrl,
    label: 'Changer mon mot de passe'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'small',
    content: 'Ce lien est valable <strong>' ~ (dto.ttlHours|e) ~ ' heures</strong> et ne peut être utilisé qu\'une seule fois. Passé ce délai, utilisez « Mot de passe oublié ? » sur la page de connexion.'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Une fois votre mot de passe modifié, connectez-vous :'
  } only %}

  {% include '@CorePhp/components/_button.html.twig' with {
    url: dto.loginUrl,
    label: 'Se connecter',
    variant: 'outline'
  } only %}

  {% include '@CorePhp/components/_divider.html.twig' only %}

  {% include '@CorePhp/components/_alert.html.twig' with {
    type: 'warning',
    title: '🛡️ Rappel de sécurité',
    content: '<ul style="margin: 8px 0 0; padding-left: 20px;">'
      ~ '<li style="padding-bottom: 4px;">Ne partagez <strong>jamais</strong> vos identifiants</li>'
      ~ '<li style="padding-bottom: 4px;">Choisissez un mot de passe fort (8 caractères minimum, majuscule, minuscule et chiffre)</li>'
      ~ '<li style="padding-bottom: 4px;"><strong>Supprimez définitivement cet e-mail</strong> après avoir changé votre mot de passe</li>'
      ~ '</ul>'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'small',
    content: 'Si vous n\'êtes pas à l\'origine de cette demande ou pensez avoir reçu cet e-mail par erreur, contactez immédiatement l\'équipe technique.'
  } only %}
{% endblock %}
