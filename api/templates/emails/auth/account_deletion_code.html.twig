{% extends '@CorePhp/layout.html.twig' %}

{% block content %}
  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h1',
    content: 'Confirmez la suppression de votre compte'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Bonjour <strong>' ~ (dto.recipientName|e) ~ '</strong>,'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Une demande de <strong>suppression définitive</strong> de votre compte a été effectuée. Pour la confirmer, saisissez ce code dans votre espace « Mon profil » :'
  } only %}

  {% include '@CorePhp/components/_code.html.twig' with {
    code: dto.code,
    role: 'danger'
  } only %}

  {% include '@CorePhp/components/_alert.html.twig' with {
    type: 'danger',
    title: 'Action irréversible',
    content: 'Toutes vos données (tâches, notes, entrées de journal, tags) et vos fichiers seront supprimés définitivement. Ce code est valable <strong>' ~ (dto.ttlMinutes|e) ~ ' minutes</strong> et ne peut être utilisé qu\'une seule fois.'
  } only %}

  {% include '@CorePhp/components/_divider.html.twig' only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'small',
    content: 'Vous n\'êtes pas à l\'origine de cette demande ? Ne communiquez ce code à personne et changez votre mot de passe : votre compte ne sera pas supprimé sans ce code.'
  } only %}
{% endblock %}
