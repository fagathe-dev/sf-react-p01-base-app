{% extends '@CorePhp/layout.html.twig' %}

{% block content %}
  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h1',
    content: 'Réinitialisation de votre mot de passe'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Bonjour <strong>' ~ (dto.recipientName|e) ~ '</strong>,'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Une demande de réinitialisation de mot de passe a été effectuée pour votre compte. Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe :'
  } only %}

  {% include '@CorePhp/components/_section.html.twig' with {
    align: 'center',
    padding: '24px 0',
    content: include('@CorePhp/components/_button.html.twig', {
      url: dto.resetUrl,
      label: 'Réinitialiser mon mot de passe',
      bg_color: '#0f172b',
      text_color: '#ffffff'
    }, with_context = false)
  } only %}

  {% include '@CorePhp/components/_alert.html.twig' with {
    type: 'warning',
    title: 'Lien temporaire',
    content: 'Pour votre sécurité, ce lien expirera automatiquement dans <strong>' ~ (dto.ttlHours|e) ~ ' heures</strong> et ne peut être utilisé qu\'une seule fois.'
  } only %}

  {% include '@CorePhp/components/_divider.html.twig' only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'small',
    color: '#64748b',
    content: 'Lien direct : ' ~ (dto.resetUrl|e)
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'small',
    color: '#64748b',
    content: 'Si vous n\'avez pas demandé la réinitialisation de votre mot de passe, aucune action n\'est requise : votre mot de passe actuel reste inchangé.'
  } only %}
{% endblock %}