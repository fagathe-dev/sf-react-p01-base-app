{% extends '@CorePhp/layout.html.twig' %}

{% block content %}
  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'h1',
    content: 'Code de vérification'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Bonjour <strong>' ~ (dto.recipientName|e) ~ '</strong>,'
  } only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'p',
    content: 'Utilisez le code à usage unique ci-dessous pour ' ~ (dto.purposeLabel|e) ~ ' :'
  } only %}

  {% include '@CorePhp/components/_code.html.twig' with {
    code: dto.otpCode
  } only %}

  {% include '@CorePhp/components/_alert.html.twig' with {
    type: 'info',
    title: 'Validité du code',
    content: 'Ce code est valable pendant <strong>' ~ ((dto.validityLabel ?? (dto.ttlMinutes ~ ' minutes'))|e) ~ '</strong>. Ne le partagez jamais avec qui que ce soit.'
  } only %}

  {% include '@CorePhp/components/_divider.html.twig' only %}

  {% include '@CorePhp/components/_text.html.twig' with {
    level: 'small',
    content: 'Si vous n\'êtes pas à l\'origine de cette demande, vous pouvez ignorer cet e-mail en toute sécurité.'
  } only %}
{% endblock %}